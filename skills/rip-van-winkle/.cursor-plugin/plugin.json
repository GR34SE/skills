{
  "name": "rip-van-winkle",
  "description": "Loads rip-van-winkle before the agent picks a version or a package.",
  "skills": [],
  "hooks": {
    "version": 1,
    "hooks": {
      "sessionStart": [
        {
          "command": "jq -Rs '{additional_context: .}' \"${CURSOR_PLUGIN_ROOT}/before-new-code.md\""
        }
      ]
    }
  }
}
